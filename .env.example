# Careers inbox. Application rows are stored even if mail is not configured.
# Mail is sent when APPLY_SMTP_* or RESEND_API_KEY is set.
APPLY_TO_EMAIL=HR@quadtechsolutions.com

# TODO [CONFIRM] Public contact inbox. If empty, contact messages use APPLY_TO_EMAIL.
CONTACT_TO_EMAIL=
# Alias used by the previous GitHub site. Either name works.
# CONTACT_EMAIL=

# Resend (previous contact integration). When RESEND_API_KEY is set, contact mail
# uses Resend instead of APPLY_SMTP_*.
RESEND_API_KEY=
# Contact form via Microsoft 365 (Graph sendMail, app-only). Preferred over Resend and SMTP when set.
# Tenant falls back to AUTH_MICROSOFT_ENTRA_ID_TENANT_ID. See docs/graph-mail-setup.md.
GRAPH_MAIL_TENANT_ID=
GRAPH_MAIL_CLIENT_ID=
GRAPH_MAIL_CLIENT_SECRET=
GRAPH_MAIL_SENDER=
# RESEND_FROM="Quad Tech Solutions <noreply@quadtechsolutions.io>"

# TODO [CONFIRM] SMTP provider. Required for HR email until RESEND_API_KEY is used for applications.
APPLY_SMTP_HOST=
APPLY_SMTP_PORT=587
APPLY_SMTP_SECURE=false
APPLY_SMTP_USER=
APPLY_SMTP_PASS=
APPLY_SMTP_FROM=

# Optional. When set, the application JSON is POSTed after the email succeeds.
# Résumé bytes are base64 only when that encoding is 5 MB or smaller.
# A webhook failure is logged and does not fail the submission.
ZAPIER_HOOK_URL=

# Gemini key for the site chat widget (/api/chat). Without it the endpoint
# returns 503 and the widget shows its offline message.
GEMINI_API_KEY=
# Optional model override. Defaults to gemini-flash-latest.
# GEMINI_MODEL=

# Auth.js session cookie secret. Generate a long random string. Do not commit the real value.
AUTH_SECRET=

# Production origin for Auth.js. Set on Vercel Production only.
# Preview deployments should omit AUTH_URL so trustHost uses the request host.
AUTH_URL=

# entra (default) or email. Email is the fallback when Entra registration is not ready.
AUTH_PROVIDER=entra

# TODO [CONFIRM: app registration created by admin]. Microsoft Entra ID, single tenant.
# See docs/admin-auth-setup.md.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
# Optional. Defaults to https://login.microsoftonline.com/<tenant>/v2.0 — never /common.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# TODO [CONFIRM: final admin list]. Comma-separated work UPNs. Example shape only; do not invent addresses.
ADMIN_UPNS=

# Local SQLite. Production on Vercel uses Neon (POSTGRES_URL / DATABASE_URL postgres://).
# A leftover file: DATABASE_URL is ignored when a postgres URL is present.
DATABASE_URL="file:./data/portal.db"
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# TODO [CONFIRM: storage target]. When set, résumés go to private Vercel Blob. On Vercel without Blob they are stored on the Application row.
BLOB_READ_WRITE_TOKEN=
